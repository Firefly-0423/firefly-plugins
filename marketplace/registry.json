    {
      "id": "dev.firefly.text-stats",
      "name": "文本统计",
      "version": "2.0.0",
      "sdk": "^1.2.0",
      "description": "离线统计文本的 Unicode 字符数、空白分隔词数和非空行数，不联网、不读写文件。",
      "author": "Firefly-0423",
      "license": "MIT",
      "native": false,
      "permissions": [],
      "tools": [
        {
          "name": "count",
          "title": "文本统计",
          "risk": [
            "fs-read"
          ],
          "modes": [
            "work",
            "code"
          ]
        }
      ],
      "capabilities": [
        "Unicode 字符、空白分隔词和非空行统计",
        "离线计算，不联网、不读写文件、不执行命令"
      ],
      "package": "https://raw.githubusercontent.com/Firefly-0423/firefly-plugins/marketplace-v2/marketplace/packages/dev.firefly.text-stats-2.0.0.ffplugin",
      "sha256": "1bcc4cccf4fadd438c454c4d2f3d3706a798651cc0b663eb9ffb874f14d35419"
    },
    {
