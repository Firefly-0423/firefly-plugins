        {
          "name": "cap",
          "title": "文本截断",
          "risk": [
            "fs-read"
          ],
          "modes": [
            "work",
            "code"
          ]
        }
      ],
      "capabilities": [
        "按 UTF-8 字节预算保留开头、结尾或两端",
        "截断落在完整字符边界上，报告确切丢弃的字节数",
        "离线计算，不联网、不读写文件、不执行命令"
      ],
      "package": "https://raw.githubusercontent.com/Firefly-0423/firefly-plugins/marketplace-v2/marketplace/packages/dev.firefly.text-trim-2.0.1.ffplugin",
      "sha256": "ade58dc6eae67b7e5c473cf598ba374908cfec23d9180026dc022fad769a01fa"
