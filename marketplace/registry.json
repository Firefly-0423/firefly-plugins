      "package": "https://raw.githubusercontent.com/Firefly-0423/firefly-plugins/marketplace-v2/marketplace/packages/dev.firefly.json-tools-2.0.1.ffplugin",
      "sha256": "06f5c168be96629d8a6179f4bbf03ff88a46271a5a39f2e6fa15d0b05b8f91f3"
